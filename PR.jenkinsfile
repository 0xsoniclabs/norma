// Norma CI test norma using "make test"

@Library('shared-library') _

pipeline {
    agent { label 'medium' }

    options {
        timestamps()
        timeout(time: 3, unit: 'HOURS')
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        DOCKER_API_VERSION = 1.45
        GOMEMLIMIT = goMemLimit()
    }

    stages {
        stage('Pre Clean-up') {
            steps {
                sh 'go run ./driver/norma purge'
            }
        }

        stage('Make Norma') {
            steps {
                sh 'make clean'
                sh 'git submodule update --init --recursive'
                sh 'make all'
            }
        }

        stage('Test Norma') {
            steps {
                sh 'cd genesis && go test ./...'
                sh 'go test ./...  -p 2 --parallel 2 --timeout 30m --failfast'
            }
        }

        // Scenarios are only checked for validity by the tests above; the ones
        // this PR adds or modifies are executed for real.
        stage('Run Changed Scenarios') {
            when { changeRequest() }
            steps {
                sh '''
                    git fetch --no-tags origin "+refs/heads/${CHANGE_TARGET}:refs/remotes/origin/${CHANGE_TARGET}"
                    files=$(git diff --name-only --diff-filter=AMR "origin/${CHANGE_TARGET}...HEAD" -- 'scenarios/**.yml' 'scenarios/**.yaml')
                    echo "scenarios to run: ${files:-<none>}"
                    for file in $files; do
                        go run ./driver/norma run --skip-report-rendering "$file"
                    done
                '''
            }
        }
    }

    post {
        always {
            sh 'go run ./driver/norma purge'
        }
    }
}
