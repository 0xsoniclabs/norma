// Norma CI test norma using "make test"

@Library('shared-library') _

pipeline {
    agent { label 'medium' }

    options {
        timestamps()
        timeout(time: 3, unit: 'HOURS')
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        GOMEMLIMIT = goMemLimit()
    }

    stages {
        stage('Pre Clean-up') {
            steps {
                sh 'go run ./driver/norma purge'
            }
        }

        stage('Check Norma Format') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh 'diff=`${GOROOT}/bin/gofmt -l \$(find . -type f -name "*.go"| grep -v "/client/")`; echo "$diff"; test -z "$diff"'
                }
            }
        }

        stage('Make Norma') {
            steps {
                sh 'make clean'
                sh 'git submodule update --init --recursive'
                sh 'make all'
            }
        }

        stage('Test Norma') {
            steps {
                sh 'cd genesis && go test ./...'
                sh 'go test ./...  -p 2 --parallel 2 --timeout 30m --failfast'
            }
        }
    }

    post {
        always {
            sh 'go run ./driver/norma purge'
        }
    }
}
